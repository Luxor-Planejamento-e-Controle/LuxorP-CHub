<?xml version="1.0"?>
<!--
  Sem atributo encoding de propósito: o Register-ScheduledTask recebe o XML como
  string UTF-16 do PowerShell, e uma declaração encoding="UTF-8" faz o parser
  abortar com "não é possível alternar codificação". Sem o atributo, funciona
  pelos dois caminhos.
-->

<!--
  Tarefa "Luxor - ETL Indicadores (hub)".

  Roda SÓ nos dias em que índice é liberado, não todo dia:
    1-3   fechamento do mês (dólar, CDI, CHF, SOFR, S&amp;P, IGP-M)
    5-16  cotas CVM (a partir do 5º dia útil, que cai entre o dia 5 e o 9 do
          calendário), IPCA (~dia 9-11) e CPI (~dia 10-13)
  A cauda até o dia 16 é margem de atraso da fonte — em 12/08/2026 o CPI de
  julho só apareceu no FRED perto do meio-dia UTC.

  08:30 BRT fica 30 min depois do Container App Job (cron 11:00 UTC), então a
  republicação do hub sempre pega o Blob já atualizado.

  Registrar / substituir:
    schtasks /Create /TN "Luxor - ETL Indicadores (hub)" /XML "C:\Users\Arthur\repos\LuxorP&amp;CHub\tools\etl_indicadores_task.xml" /F
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Republica o painel Indicadores do hub depois do Container App Job: indices de mercado -&gt; cotas CVM -&gt; build_data -&gt; publish_hub. Dias 1-3 e 5-16, 08:30 BRT.</Description>
    <URI>\Luxor - ETL Indicadores (hub)</URI>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-08-12T08:30:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByMonth>
        <DaysOfMonth>
          <Day>1</Day>
          <Day>2</Day>
          <Day>3</Day>
          <Day>5</Day>
          <Day>6</Day>
          <Day>7</Day>
          <Day>8</Day>
          <Day>9</Day>
          <Day>10</Day>
          <Day>11</Day>
          <Day>12</Day>
          <Day>13</Day>
          <Day>14</Day>
          <Day>15</Day>
          <Day>16</Day>
        </DaysOfMonth>
        <Months>
          <January /><February /><March /><April /><May /><June />
          <July /><August /><September /><October /><November /><December />
        </Months>
      </ScheduleByMonth>
    </CalendarTrigger>
  </Triggers>
  <!--
    Sem bloco <Principals> de propósito: quem define o usuário é o parâmetro
    -User do Register-ScheduledTask. Um <UserId> aqui conflita com ele e o
    registro falha com "Parâmetro incorreto (UserId)".
  -->
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>true</RunOnlyIfNetworkAvailable>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT2H</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions>
    <Exec>
      <Command>C:\Users\Arthur\repos\LuxorP&amp;CHub\tools\run_etl_indicadores_agendado.cmd</Command>
    </Exec>
  </Actions>
</Task>
